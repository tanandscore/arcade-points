# Copy this file to .env.local for local dev, and paste the same
# values into Cloudflare's "Variables and Secrets" settings when you deploy
# (Workers & Pages -> arcade-points -> Settings -> Variables and Secrets).

# From Supabase: Project Settings -> API
# Tip: when creating the Supabase project, pick the "Mumbai (ap-south-1)"
# region so it's fast for users in India.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# From Razorpay: Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Your site's own URL
# Local dev: http://localhost:3000
# Production: https://tapandscore.com (set this once your domain is connected — see README Step 5)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
